# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Generate Dune rules for building a client/server application or library"
maintainer: ["Jules Aguillon <jules@j3s.fr>"]
authors: ["Jules Aguillon <jules@j3s.fr>"]
license: "MIT"
homepage: "https://github.com/ocsigen/ocsigen-dune-rules"
bug-reports: "https://github.com/ocsigen/ocsigen-dune-rules/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14"}
  "cmdliner"
  "ocsigen-ppx-rpc"
  "js_of_ocaml-ppx_deriving_json"
  "eliom" {>= "13.0~"}
  "ocsigenserver" {with-test}
  "ocsipersist-sqlite" {with-test}
  "js_of_ocaml" {with-test}
  "js_of_ocaml-lwt" {with-test}
  "js_of_ocaml-ppx" {with-test}
  "bigstringaf" {with-test & >= "0.7.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ocsigen/ocsigen-dune-rules.git"
